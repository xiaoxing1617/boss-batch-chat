{
  "manifest_version": 3,
  "name": "Boss 批量沟通",
  "version": "0.5.0",
  "description": "在 Boss 直聘职位列表里勾选想沟通的职位，逐个打招呼并按顺序发送多条文本/图片消息。",
  "homepage_url": "https://github.com/xiaoxing1617/boss-batch-chat",
  "minimum_chrome_version": "111",
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.github.com/*",
    "https://codeload.github.com/*",
    "https://www.zhipin.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.zhipin.com/web/geek/*"],
      "js": ["src/main.js"],
      "css": ["src/panel.css"],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.zhipin.com/web/geek/*"],
      "js": ["src/bridge.js"],
      "run_at": "document_start"
    }
  ]
}
